{
  "name": "station-zero",
  "version": "0.0.1",
  "description": "A 2D isometric retro-futuristic dungeon crawler focused on pure survival",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "art:build": "node tools/build-art.mjs",
    "audio:build": "node tools/build-audio.mjs",
    "levels:bake": "node tools/bake-levels.mjs",
    "levels:check": "node tools/check-levels.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
